    {
      "id": "CrfWg9fJkMWFXyLfaoa-y",
      "type": "text",
      "x": 171.386674037686,
      "y": 393.7499694824219,
      "width": 907.2193603515625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 1989943962,
      "version": 585,
      "versionNonce": 1351065286,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793028286092,
      "link": null,
      "locked": false,
      "text": "This a common pattern where you're going to merge everything into dev/stanging/testing.\n- main is the branch that a regular non staff user would see in production\n- dev/staging/testing is going to be what's sent internally\n- feature branches will be merged in to staging and then passed merged once testing is done.\n\nYou should try as much as possible to keep the branches to 1 layer from the dev branch.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This a common pattern where you're going to merge everything into dev/stanging/testing.\n- main is the branch that a regular non staff user would see in production\n- dev/staging/testing is going to be what's sent internally\n- feature branches will be merged in to staging and then passed merged once testing is done.\n\nYou should try as much as possible to keep the branches to 1 layer from the dev branch.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
