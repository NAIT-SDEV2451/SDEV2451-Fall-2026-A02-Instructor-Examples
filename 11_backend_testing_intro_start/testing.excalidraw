      "version": 239,
      "versionNonce": 1347050379,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793200986400,
      "link": null,
      "locked": false,
      "text": "- A test that will evaluate multiple units of code \ntogether.\n- for us this will be using the client to make api \nrequests to our backend to make sure we get what\nwe expect.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A test that will evaluate multiple units of code \ntogether.\n- for us this will be using the client to make api \nrequests to our backend to make sure we get what\nwe expect.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9tZHcd2LcLuK8PEhX2Pja",
      "type": "text",
      "x": 939,
      "y": 266,
      "width": 458.06353759765625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
