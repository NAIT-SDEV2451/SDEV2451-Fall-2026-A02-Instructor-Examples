      "seed": 572335781,
      "version": 268,
      "versionNonce": 1439864773,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793200980299,
      "link": null,
      "locked": false,
      "text": "Backend end tests are the most important why? because\nthis is the data layer, you can't compromise or have errors\nin this layer otherwise everything breaks. Testing is \nrequired, if it's not there it's stressful.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backend end tests are the most important why? because\nthis is the data layer, you can't compromise or have errors\nin this layer otherwise everything breaks. Testing is \nrequired, if it's not there it's stressful.",
      "autoResize": true,
      "lineHeight": 1.25
    },
