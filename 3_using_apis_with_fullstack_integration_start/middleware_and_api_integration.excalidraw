    {
      "id": "sg57-rLGNfN2oPczZn_xL",
      "type": "text",
      "x": 1189.2792075239934,
      "y": 84.2098582208499,
      "width": 476.7996826171875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 892343257,
      "version": 474,
      "versionNonce": 222585271,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789572672859,
      "link": null,
      "locked": false,
      "text": "Async API Call (using tanstack query)\n- if you use useState with this there's a lot you\nneed to consider\n- asynchronous state management library that is\nmainly focused on making and handling requests\nto a backend server.\n  - useQuery (get)\n    - get info and have a query key\n  - mutations (post/patch/put/delete)\n    - you're changing info on the server\n    - invalidate the query key (for useQuery)\n    this will fetch the data again.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Async API Call (using tanstack query)\n- if you use useState with this there's a lot you\nneed to consider\n- asynchronous state management library that is\nmainly focused on making and handling requests\nto a backend server.\n  - useQuery (get)\n    - get info and have a query key\n  - mutations (post/patch/put/delete)\n    - you're changing info on the server\n    - invalidate the query key (for useQuery)\n    this will fetch the data again.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff"
  },
  "files": {}
